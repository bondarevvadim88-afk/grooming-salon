# ──────────────────────────────────────────────────────────
# .env.example  —  copy to .env and fill in real values
# NEVER commit the real .env to git
# ──────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://yoursalon.ru,https://admin.yoursalon.ru

# ── Database ─────────────────────────────────────────────
# Railway provides this automatically as DATABASE_URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://user:password@localhost:5432/grooming_db

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# R7 fix: always set a strong password in production
REDIS_PASSWORD=

# ── JWT ──────────────────────────────────────────────────
# R3 fix: use `openssl rand -base64 32` to generate — minimum 32 chars
JWT_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_32_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── SMS (SMSC.ru) ─────────────────────────────────────────
SMS_PROVIDER=smsc
SMS_API_KEY=
SMS_SENDER=GROOMING

# ── Email ────────────────────────────────────────────────
# R8 fix: port 587 requires STARTTLS
# nodemailer config: { secure: false, requireTLS: true }
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=noreply@yoursalon.ru
SMTP_PASS=
SMTP_FROM=ГрумПро <noreply@yoursalon.ru>

# ── Telegram Bot ─────────────────────────────────────────
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://yoursalon.ru/webhook/telegram

# ── VK ───────────────────────────────────────────────────
VK_SERVICE_TOKEN=
VK_GROUP_ID=

# ── MAX (mail.ru) ────────────────────────────────────────
MAX_API_KEY=
MAX_BOT_ID=

# ── Firebase Push ────────────────────────────────────────
FCM_SERVER_KEY=
