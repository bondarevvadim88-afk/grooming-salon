// prisma/schema.prisma
// Generated for ГрумПро booking service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Client ───────────────────────────────────────────────────────────

model Client {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pets         Pet[]
  appointments Appointment[]
  preferences  NotificationPreference?

  @@index([phone])
}

// ─── Pet ──────────────────────────────────────────────────────────────

model Pet {
  id        String   @id @default(uuid())
  clientId  String
  name      String
  type      PetType
  breed     String?
  size      PetSize
  age       Int?
  notes     String?
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([clientId])
}

enum PetType { DOG CAT OTHER }
enum PetSize { SMALL MEDIUM LARGE }

// ─── Staff ────────────────────────────────────────────────────────────

model Staff {
  id           String   @id @default(uuid())
  name         String
  specialty    String
  bio          String?
  avatarUrl    String?
  rating       Float    @default(5.0)
  reviewsCount Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workSchedules WorkSchedule[]
  appointments  Appointment[]
  services      StaffService[]

  @@index([isActive])
}

// ─── WorkSchedule ─────────────────────────────────────────────────────

model WorkSchedule {
  id        String  @id @default(uuid())
  staffId   String
  dayOfWeek Int     // 1=Mon … 7=Sun (ISO)
  startTime String  // "09:00"
  endTime   String  // "19:00"
  isWorking Boolean @default(true)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@index([staffId])
}

// ─── Service ──────────────────────────────────────────────────────────

model Service {
  id          String  @id @default(uuid())
  name        String
  description String?
  basePrice   Float
  durationMin Int
  isActive    Boolean @default(true)
  coefSmall   Float   @default(0.8)
  coefMedium  Float   @default(1.0)
  coefLarge   Float   @default(1.5)

  staff        StaffService[]
  appointments Appointment[]

  @@index([isActive])
}

// ─── StaffService (join table) ────────────────────────────────────────

model StaffService {
  staffId   String
  serviceId String

  staff   Staff   @relation(fields: [staffId],   references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

// ─── Appointment ──────────────────────────────────────────────────────

model Appointment {
  id         String            @id @default(uuid())
  clientId   String
  petId      String
  staffId    String
  serviceId  String
  startAt    DateTime
  endAt      DateTime
  status     AppointmentStatus @default(PENDING)
  totalPrice Float
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  client        Client         @relation(fields: [clientId],  references: [id])
  pet           Pet            @relation(fields: [petId],     references: [id])
  staff         Staff          @relation(fields: [staffId],   references: [id])
  service       Service        @relation(fields: [serviceId], references: [id])
  notifications Notification[]
  review        Review?

  // R4 fix: indexes for filter/join queries (no table scans at scale)
  @@index([clientId])
  @@index([staffId])
  @@index([startAt])
  @@index([status])
  @@index([staffId, startAt]) // composite: schedule grid queries
}

enum AppointmentStatus {
  PENDING       // awaiting confirmation
  CONFIRMED     // confirmed — JS frontend maps this as "confirmed"
  IN_PROGRESS   // in progress — JS frontend maps this as "inprog" (R1: use enum, not string)
  COMPLETED     // completed
  CANCELLED     // cancelled
  NO_SHOW       // client did not show
}

// ─── Notification ─────────────────────────────────────────────────────

model Notification {
  id            String              @id @default(uuid())
  appointmentId String
  channel       NotificationChannel
  type          NotificationType
  status        NotificationStatus  @default(PENDING)
  payload       Json
  sentAt        DateTime?
  deliveredAt   DateTime?
  errorMessage  String?
  retryCount    Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt  // R9 fix: track retry timestamps

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  // R5 fix: indexes for delivery log queries
  @@index([appointmentId])
  @@index([status])
  @@index([channel])
  @@index([type])
}

enum NotificationChannel { SMS EMAIL TELEGRAM VK MAX PUSH }

enum NotificationType {
  BOOKING_CONFIRMED
  REMINDER_24H
  REMINDER_2H
  BOOKING_CANCELLED
  REVIEW_REQUEST
  BOOKING_CHANGED
}

enum NotificationStatus { PENDING SENT DELIVERED FAILED }

// ─── NotificationPreference ───────────────────────────────────────────

model NotificationPreference {
  clientId       String  @id
  smsEnabled     Boolean @default(true)
  emailEnabled   Boolean @default(true)
  telegramChatId String?
  vkUserId       String?
  maxUserId      String?
  pushToken      String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// ─── Review ───────────────────────────────────────────────────────────

model Review {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  rating        Int      // 1–5
  comment       String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}
